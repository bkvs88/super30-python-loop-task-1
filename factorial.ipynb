   "source": [
    "### Calculate the factorial of a number without using any built-in factorial function."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "7df1dbeb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total factorial of 5 is 120\n"
     ]
    }
   ],
   "source": [
    "num_inp = int(input(\"enter any number for factorial\"))\n",
    "fact=1\n",
    "temp=num_inp\n",
    "while num_inp >= 1 :\n",
    "    fact = fact * num_inp\n",
    "    num_inp = num_inp - 1\n",
    "\n",
    "print(f\"Total factorial of {temp} is {fact}\")"
   ]
  },
