   "source": [
    "### Reverse a string using a for loop without using [::-1] or reversed()."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "59dac174",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "OLLEH\n"
     ]
    }
   ],
   "source": [
    "input_string = \"HELLO\"\n",
    "reversed_str=\"\"\n",
    "for i in input_string:\n",
    "   reversed_str= i + reversed_str\n",
    "print(reversed_str)"
   ]
